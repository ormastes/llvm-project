#!/bin/sh
# Mirror of /home/yoon/dev/simple/src/os/port/llvm/sysroot.shs for lane C1.
# Identical commands/flags; deviations from the original are ONLY:
#   1. Output paths redirected from $REPO_ROOT/build/os/... to
#      /home/yoon/llvm-project-simpleos/build-os-llvm/... (Simple repo is
#      read-only for this lane).
#   2. libsimpleos_c.a is built from a COPY of src/os/libc (the original
#      runs `make` inside the source tree, which would write .o files into
#      the read-only Simple repo).
# Everything else mirrors sysroot.shs step for step (x86_64 branch).

set -e

REPO_ROOT=/home/yoon/dev/simple          # read-only inputs only
LIBC_DIR="$REPO_ROOT/src/os/libc"
WORK=/home/yoon/llvm-project-simpleos/build-os-llvm
LLVM_SRC=/home/yoon/llvm-project-simpleos
SYSROOT="$WORK/sysroot"
TRIPLE=x86_64-unknown-simpleos
SIMPLE_BUILD_JOBS=20
LIBC_BUILD="$WORK/libc-build-x86_64"
LIBCXX_BUILD="$WORK/libcxx-x86_64-unknown-simpleos"
LIBCXXABI_BUILD="$WORK/libcxxabi-x86_64-unknown-simpleos"
LIBUNWIND_BUILD="$WORK/libunwind-x86_64-unknown-simpleos"

CC="${CC:-clang}"
CXX="${CXX:-clang++}"
if command -v llvm-ar >/dev/null 2>&1; then AR=llvm-ar; else AR=ar; fi

echo "[sysroot-mirror] Building SimpleOS sysroot at $SYSROOT (triple $TRIPLE)"

mkdir -p "$SYSROOT/include" "$SYSROOT/lib" "$SYSROOT/share/simpleos"
rm -f "$SYSROOT/share/simpleos/target-triple.txt"

# -- Headers (same as sysroot.shs) -------------------------------------------
cp "$LIBC_DIR/simpleos_libc.h" "$SYSROOT/include/"
if [ -d "$LIBC_DIR/include" ]; then
    cp -R "$LIBC_DIR/include/." "$SYSROOT/include/"
fi
HEADER_COUNT=$(find "$SYSROOT/include" \( -name "*.h" -o -name "*.hpp" \) 2>/dev/null | wc -l | tr -d ' ')
echo "[sysroot-mirror] Installed $HEADER_COUNT headers"

# -- libc++ header tree (DEVIATION: sysroot.shs expects include/c++/v1 to
#    already contain the full libc++ headers, but src/os/libc/include/c++
#    only ships 8 C wrapper headers at this commit. Stage the fork's libc++
#    headers and generate the __config_site that clang_static.shs documents
#    as the Phase-3 pinned config.)
echo "[sysroot-mirror] Staging libc++ headers into include/c++/v1 ..."
mkdir -p "$SYSROOT/include/c++/v1"
cp -R "$LLVM_SRC/libcxx/include/." "$SYSROOT/include/c++/v1/"
cp "$LLVM_SRC/libcxx/vendor/llvm/default_assertion_handler.in" \
    "$SYSROOT/include/c++/v1/__assertion_handler"
cat > "$SYSROOT/include/c++/v1/__config_site" << 'EOF'
// Generated by build-os-llvm/scripts/sysroot-mirror.shs (lane C1).
// Phase-3 pinned ABI per src/os/port/llvm/clang_static.shs, freestanding knobs.
#ifndef _LIBCPP___CONFIG_SITE
#define _LIBCPP___CONFIG_SITE
#define _LIBCPP_ABI_VERSION 1
#define _LIBCPP_ABI_NAMESPACE __1
#define _LIBCPP_HAS_THREADS 1
#define _LIBCPP_HAS_THREAD_API_PTHREAD 1
#define _LIBCPP_HAS_MONOTONIC_CLOCK 1
#define _LIBCPP_HAS_TERMINAL 0
#define _LIBCPP_HAS_RANDOM_DEVICE 1
#define _LIBCPP_HARDENING_MODE_DEFAULT _LIBCPP_HARDENING_MODE_NONE
/* PSTL backend: must live here (not only in -D flags) so TUs compiled with
   the libc++abi/libunwind flag sets (which lack the -D) still see it. */
#define _LIBCPP_PSTL_BACKEND_SERIAL 1
#define _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE 1
#define _LIBCPP_HAS_WIDE_CHARACTERS 1
/* Fork patches (0005-0017) gate std::ostream paths on
   defined(_LIBCPP_HAS_LOCALIZATION) && !_LIBCPP_HAS_LOCALIZATION. */
#define _LIBCPP_HAS_LOCALIZATION 0
#endif
EOF
echo "[sysroot-mirror] Staged libc++ headers + generated __config_site"

# -- libc++ decl/impl shims (DEVIATION: libc++ string.cpp references strtold
#    and the wcstod family, which SimpleOS libc does not declare or implement
#    at this commit — more repo drift vs the 2026-08-06 sysroot. Patch only
#    the SYSROOT COPIES of the headers and add narrow-and-delegate fallback
#    implementations to libsimpleos_c.a; the Simple repo stays untouched.)
if ! grep -q "strtold" "$SYSROOT/include/stdlib.h"; then
    echo "[sysroot-mirror] Adding strtold/wcst* shims to sysroot headers + libc"
    cat >> "$SYSROOT/include/stdlib.h" << 'EOF'

/* lane-C1 freestanding shim: LLVM libc++ string.cpp references strtold. */
#ifndef _SIMPLEOS_STRTOLD_DECL
#define _SIMPLEOS_STRTOLD_DECL
#ifdef __cplusplus
extern "C" {
#endif
long double strtold(const char *nptr, char **endptr);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
# Full rewrite of the sysroot wchar.h copy: C++-safe wchar_t typedef, mbstate_t,
# and the wide-char decl family libc++ needs (v1/wchar.h const-overload
# wrappers + char_traits<wchar_t>). Simple repo header stays untouched.
cat > "$SYSROOT/include/wchar.h" << 'EOF'
/* lane-C1 sysroot copy of the SimpleOS wchar.h — restructured for C/C++
   interop (LLVM libc++ <wchar.h>/<iosfwd> chain): wchar_t typedef guarded
   for C++, mbstate_t provided, wide-char function family declared.
   The Simple repo's original header remains untouched; this is the
   sysroot artifact only. */
#ifndef SIMPLEOS_WCHAR_H
#define SIMPLEOS_WCHAR_H

#include <stddef.h>
/* libc++ <cwchar> expects the C <wchar.h> to expose FILE (glibc behavior):
   pull the providers in; no cycles (SimpleOS stdio.h/time.h don't include
   wchar.h). */
#include <stdio.h>
#include <time.h>

#ifndef _WCHAR_T
#define _WCHAR_T
#ifndef __cplusplus
typedef __WCHAR_TYPE__ wchar_t;
#endif
#endif
typedef unsigned int wint_t;
#define WEOF ((wint_t)-1)

#ifndef _SIMPLEOS_MBSTATE_T
#define _SIMPLEOS_MBSTATE_T
#if defined(__has_include)
#  if __has_include(<bits/types/mbstate_t.h>)
#    include <bits/types/mbstate_t.h>
#  else
typedef struct {
    int __count;
    union { unsigned int __wch; char __wchb[4]; } __value;
} mbstate_t;
#  endif
#else
typedef struct {
    int __count;
    union { unsigned int __wch; char __wchb[4]; } __value;
} mbstate_t;
#endif
#endif

#ifdef __cplusplus
extern "C" {
#endif

size_t wcslen(const wchar_t *s);
int wcscmp(const wchar_t *a, const wchar_t *b);
int wcsncmp(const wchar_t *a, const wchar_t *b, size_t n);
wchar_t *wcscpy(wchar_t *dst, const wchar_t *src);
wchar_t *wcsncpy(wchar_t *dst, const wchar_t *src, size_t n);
wchar_t *wcscat(wchar_t *dst, const wchar_t *src);
wchar_t *wcsncat(wchar_t *dst, const wchar_t *src, size_t n);
wchar_t *wcschr(const wchar_t *s, wchar_t c);
wchar_t *wcsrchr(const wchar_t *s, wchar_t c);
wchar_t *wcsstr(const wchar_t *haystack, const wchar_t *needle);
wchar_t *wcspbrk(const wchar_t *s, const wchar_t *accept);
size_t mbstowcs(wchar_t *dst, const char *src, size_t n);
size_t wcstombs(char *dst, const wchar_t *src, size_t n);
int mbtowc(wchar_t *pwc, const char *s, size_t n);
int wctomb(char *s, wchar_t wc);
int mbsinit(const mbstate_t *ps);
int wmemcmp(const wchar_t *a, const wchar_t *b, size_t n);
wchar_t *wmemcpy(wchar_t *dst, const wchar_t *src, size_t n);
wchar_t *wmemmove(wchar_t *dst, const wchar_t *src, size_t n);
wchar_t *wmemchr(const wchar_t *s, wchar_t c, size_t n);
wchar_t *wmemset(wchar_t *s, wchar_t c, size_t n);
int swprintf(wchar_t *str, size_t n, const wchar_t *fmt, ...);
int vswprintf(wchar_t *str, size_t n, const wchar_t *fmt, __builtin_va_list ap);
int fwprintf(FILE *stream, const wchar_t *fmt, ...);
int vfwprintf(FILE *stream, const wchar_t *fmt, __builtin_va_list ap);
int wprintf(const wchar_t *fmt, ...);
int vwprintf(const wchar_t *fmt, __builtin_va_list ap);
wchar_t *fgetws(wchar_t *str, int n, FILE *stream);
int fputws(const wchar_t *str, FILE *stream);
wint_t fgetwc(FILE *stream);
wint_t fputwc(wchar_t c, FILE *stream);
wint_t ungetwc(wint_t c, FILE *stream);
int fwide(FILE *stream, int mode);
double      wcstod(const wchar_t *nptr, wchar_t **endptr);
float       wcstof(const wchar_t *nptr, wchar_t **endptr);
long double wcstold(const wchar_t *nptr, wchar_t **endptr);
long wcstol(const wchar_t *nptr, wchar_t **endptr, int base);
unsigned long wcstoul(const wchar_t *nptr, wchar_t **endptr, int base);
long long wcstoll(const wchar_t *nptr, wchar_t **endptr, int base);
unsigned long long wcstoull(const wchar_t *nptr, wchar_t **endptr, int base);

#ifdef __cplusplus
}
#endif
#endif
EOF
# locale.h: restore the SimpleOS original from the repo, then append the
# libc++ __locale guard API (locale_t/newlocale/uselocale family) — the
# original header has setlocale/localeconv/lconv but no locale_t.
if ! grep -q "uselocale" "$SYSROOT/include/locale.h"; then
    git -C "$REPO_ROOT" show HEAD:src/os/libc/include/locale.h > "$SYSROOT/include/locale.h" 2>/dev/null \
        || cp "$LIBC_DIR/include/locale.h" "$SYSROOT/include/locale.h"
    cat >> "$SYSROOT/include/locale.h" << 'EOF'

/* lane-C1 freestanding shims: libc++ __locale guard API (single-locale). */
#ifndef _SIMPLEOS_LOCALE_LANEC1
#define _SIMPLEOS_LOCALE_LANEC1
#define LC_COLLATE_MASK  (1 << 1)
#define LC_CTYPE_MASK    (1 << 2)
#define LC_MONETARY_MASK (1 << 3)
#define LC_NUMERIC_MASK  (1 << 4)
#define LC_TIME_MASK     (1 << 5)
#define LC_MESSAGES_MASK (1 << 6)
#define LC_ALL_MASK 0x1fffff
typedef struct __simpleos_locale *locale_t;
locale_t newlocale(int mask, const char *name, locale_t base);
locale_t duplocale(locale_t loc);
void freelocale(locale_t loc);
locale_t uselocale(locale_t loc);
#endif
EOF
fi
if ! grep -q "MB_CUR_MAX" "$SYSROOT/include/stdlib.h"; then
    cat >> "$SYSROOT/include/stdlib.h" << 'EOF'

/* lane-C1 freestanding shim: libc++ bsd_locale_fallbacks.h. */
#ifndef MB_CUR_MAX
#define MB_CUR_MAX 1
#endif
EOF
fi
if ! grep -q "strtof_l" "$SYSROOT/include/stdlib.h"; then
    cat >> "$SYSROOT/include/stdlib.h" << 'EOF'

/* lane-C1 freestanding shims: libc++ locale_base_api *_l family. */
#ifndef _SIMPLEOS_STDLIB_L_LANEC1
#define _SIMPLEOS_STDLIB_L_LANEC1
#include <locale.h>
#ifdef __cplusplus
extern "C" {
#endif
float strtof_l(const char *nptr, char **endptr, locale_t loc);
double strtod_l(const char *nptr, char **endptr, locale_t loc);
long double strtold_l(const char *nptr, char **endptr, locale_t loc);
long long strtoll_l(const char *nptr, char **endptr, int base, locale_t loc);
unsigned long long strtoull_l(const char *nptr, char **endptr, int base, locale_t loc);
int strcoll_l(const char *a, const char *b, locale_t loc);
size_t strxfrm_l(char *dst, const char *src, size_t n, locale_t loc);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "tolower_l" "$SYSROOT/include/ctype.h"; then
    cat >> "$SYSROOT/include/ctype.h" << 'EOF'

/* lane-C1 freestanding shims: libc++ locale_base_api ctype *_l family. */
#ifndef _SIMPLEOS_CTYPE_L_LANEC1
#define _SIMPLEOS_CTYPE_L_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
int tolower_l(int c, locale_t loc);
int toupper_l(int c, locale_t loc);
int isdigit_l(int c, locale_t loc);
int islower_l(int c, locale_t loc);
int isupper_l(int c, locale_t loc);
int isxdigit_l(int c, locale_t loc);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "iswalpha_l" "$SYSROOT/include/wctype.h"; then
    cat >> "$SYSROOT/include/wctype.h" << 'EOF'

/* lane-C1 freestanding shims: libc++ locale_base_api wctype *_l family. */
#ifndef _SIMPLEOS_WCTYPE_L_LANEC1
#define _SIMPLEOS_WCTYPE_L_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
wint_t towlower_l(wint_t c, locale_t loc);
wint_t towupper_l(wint_t c, locale_t loc);
int iswalpha_l(wint_t c, locale_t loc);
int iswblank_l(wint_t c, locale_t loc);
int iswcntrl_l(wint_t c, locale_t loc);
int iswdigit_l(wint_t c, locale_t loc);
int iswlower_l(wint_t c, locale_t loc);
int iswprint_l(wint_t c, locale_t loc);
int iswpunct_l(wint_t c, locale_t loc);
int iswspace_l(wint_t c, locale_t loc);
int iswupper_l(wint_t c, locale_t loc);
int iswxdigit_l(wint_t c, locale_t loc);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "strftime_l" "$SYSROOT/include/time.h"; then
    cat >> "$SYSROOT/include/time.h" << 'EOF'

/* lane-C1 freestanding shim: libc++ locale_base_api. */
#ifndef _SIMPLEOS_TIME_L_LANEC1
#define _SIMPLEOS_TIME_L_LANEC1
#include <locale.h>
#ifdef __cplusplus
extern "C" {
#endif
size_t strftime_l(char *s, size_t max, const char *fmt, const struct tm *tm, locale_t loc);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "wcscoll_l" "$SYSROOT/include/wchar.h"; then
    cat >> "$SYSROOT/include/wchar.h" << 'EOF'

/* lane-C1 freestanding shims: libc++ locale_base_api wide collate. */
#ifndef _SIMPLEOS_WCHAR_L_LANEC1
#define _SIMPLEOS_WCHAR_L_LANEC1
#include <locale.h>
#ifdef __cplusplus
extern "C" {
#endif
int wcscoll_l(const wchar_t *a, const wchar_t *b, locale_t loc);
size_t wcsxfrm_l(wchar_t *dst, const wchar_t *src, size_t n, locale_t loc);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "mbtowc" "$SYSROOT/include/stdlib.h"; then
    cat >> "$SYSROOT/include/stdlib.h" << 'EOF'

/* lane-C1 freestanding shims (libc++ locale fallbacks). */
#ifndef _SIMPLEOS_STDLIB_LANEC1
#define _SIMPLEOS_STDLIB_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
int mbtowc(wchar_t *pwc, const char *s, size_t n);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "vasprintf" "$SYSROOT/include/stdio.h"; then
    cat >> "$SYSROOT/include/stdio.h" << 'EOF'

/* lane-C1 freestanding shims (libc++ locale fallbacks). */
#ifndef _SIMPLEOS_STDIO_LANEC1
#define _SIMPLEOS_STDIO_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
int vasprintf(char **strp, const char *fmt, va_list ap);
int vsscanf(const char *str, const char *fmt, va_list ap);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "wcsnrtombs" "$SYSROOT/include/wchar.h"; then
    cat >> "$SYSROOT/include/wchar.h" << 'EOF'

/* lane-C1 freestanding shims: libc++ bsd_locale_fallbacks.h restartables. */
#ifndef _SIMPLEOS_WCHAR_RESTARTABLE_LANEC1
#define _SIMPLEOS_WCHAR_RESTARTABLE_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
size_t mbsrtowcs(wchar_t *dst, const char **src, size_t len, void *ps);
size_t wcsrtombs(char *dst, const wchar_t **src, size_t len, void *ps);
size_t mbsnrtowcs(wchar_t *dst, const char **src, size_t nms, size_t len, void *ps);
size_t wcsnrtombs(char *dst, const wchar_t **src, size_t nwc, size_t len, void *ps);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "strerror_r" "$SYSROOT/include/string.h"; then
    cat >> "$SYSROOT/include/string.h" << 'EOF'

/* lane-C1 freestanding shim: LLVM libc++ system_error.cpp uses GNU strerror_r. */
#ifndef _SIMPLEOS_STRERROR_R_DECL
#define _SIMPLEOS_STRERROR_R_DECL
#ifdef __cplusplus
extern "C" {
#endif
char *strerror_r(int errnum, char *buf, unsigned long buflen);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "pthread_cond_timedwait" "$SYSROOT/include/pthread.h"; then
    cat >> "$SYSROOT/include/pthread.h" << 'EOF'

/* lane-C1 freestanding shims: LLVM libc++ __thread/support/pthread.h needs
   these; pthread_cond_timedwait IS implemented by simpleos_pthread_cond.c,
   the rest are accepted-as-noop fallbacks. */
#ifndef _SIMPLEOS_PTHREAD_LANEC1_SHIMS
#define _SIMPLEOS_PTHREAD_LANEC1_SHIMS
#ifdef __cplusplus
extern "C" {
#endif
#define PTHREAD_MUTEX_NORMAL 0
#define PTHREAD_MUTEX_RECURSIVE 1
#define PTHREAD_MUTEX_ERRORCHECK 2
int pthread_mutexattr_settype(pthread_mutexattr_t *attr, int type);
int pthread_cond_timedwait(pthread_cond_t *cond, pthread_mutex_t *mutex,
                           const struct timespec *abstime);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
# LP64 correctness: SimpleOS spells int64_t as long long; on x86_64 LP64
# `long` is the correct underlying type (matches INT64_C L-suffixes and
# prevents ambiguous overload resolution in LLVM headers).
sed -i 's/^typedef long long          int64_t;/typedef long               int64_t;/; s/^typedef unsigned long long uint64_t;/typedef unsigned long      uint64_t;/' "$SYSROOT/include/stdint.h"
if ! grep -q "INT64_C" "$SYSROOT/include/stdint.h"; then
    cat >> "$SYSROOT/include/stdint.h" << 'EOF'

/* lane-C1 freestanding shim: C99 INT64_C/UINT64_C macro constants family
   (LLVM headers use them under __STDC_CONSTANT_MACROS). LP64 spellings. */
#ifndef INT8_C
#define INT8_C(c)   c
#define INT16_C(c)  c
#define INT32_C(c)  c
#define INT64_C(c)  c ## L
#define UINT8_C(c)  c ## U
#define UINT16_C(c) c ## U
#define UINT32_C(c) c ## U
#define UINT64_C(c) c ## UL
#define INTMAX_C(c)  c ## L
#define UINTMAX_C(c) c ## UL
#endif
EOF
fi
# -- POSIX decl/impl shims for the LLVM Support Unix layer -------------------
if ! grep -q "F_SETLK" "$SYSROOT/include/fcntl.h"; then
    cat >> "$SYSROOT/include/fcntl.h" << 'EOF'

/* lane-C1 freestanding shims: LLVM Support/Unix/Path.inc file locking. */
#ifndef _SIMPLEOS_FCNTL_LANEC1_SHIMS
#define _SIMPLEOS_FCNTL_LANEC1_SHIMS
#ifdef __cplusplus
extern "C" {
#endif
#define F_RDLCK 0
#define F_WRLCK 1
#define F_UNLCK 2
#define F_GETLK 5
#define F_SETLK 6
#define F_SETLKW 7
struct flock {
    short l_type;
    short l_whence;
    off_t l_start;
    off_t l_len;
    pid_t l_pid;
};
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "readlink" "$SYSROOT/include/unistd.h"; then
    cat >> "$SYSROOT/include/unistd.h" << 'EOF'

/* lane-C1 freestanding shim: LLVM Path.inc real_path() /proc branch. */
#ifndef _SIMPLEOS_READLINK_DECL
#define _SIMPLEOS_READLINK_DECL
#ifdef __cplusplus
extern "C" {
#endif
ssize_t readlink(const char *path, char *buf, size_t bufsize);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "wait4" "$SYSROOT/include/sys/wait.h"; then
    cat >> "$SYSROOT/include/sys/wait.h" << 'EOF'

/* lane-C1 freestanding shims: LLVM Support/Unix/Program.inc ExecuteAndWait. */
#ifndef _SIMPLEOS_WAIT_LANEC1_SHIMS
#define _SIMPLEOS_WAIT_LANEC1_SHIMS
#ifdef __cplusplus
extern "C" {
#endif
#include <sys/resource.h>
pid_t wait4(pid_t pid, int *wstatus, int options, struct rusage *rusage);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
# -- Second POSIX shim wave: LLVM Support Unix layer decls + fallback impls --
if ! grep -q "_SC_GETPW_R_SIZE_MAX" "$SYSROOT/include/unistd.h"; then
    cat >> "$SYSROOT/include/unistd.h" << 'EOF'

/* lane-C1 freestanding shims: LLVM Support/Unix/Path.inc + Program.inc. */
#ifndef _SIMPLEOS_UNISTD_LANEC1
#define _SIMPLEOS_UNISTD_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
#define _SC_GETPW_R_SIZE_MAX 70
int fchown(int fd, unsigned int owner, unsigned int group);
ssize_t sbrk(ssize_t increment);
int symlink(const char *target, const char *linkpath);
int link(const char *oldpath, const char *newpath);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "S_ISSOCK" "$SYSROOT/include/sys/stat.h"; then
    cat >> "$SYSROOT/include/sys/stat.h" << 'EOF'

/* lane-C1 freestanding shims: LLVM Support/Unix/Path.inc. */
#ifndef _SIMPLEOS_STAT_LANEC1
#define _SIMPLEOS_STAT_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
#include <time.h>
#define S_IFSOCK 0140000
#define S_ISSOCK(m) (((m) & S_IFMT) == S_IFSOCK)
mode_t umask(mode_t mask);
int fchmod(int fd, mode_t mode);
int futimens(int fd, const struct timespec times[2]);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "posix_madvise" "$SYSROOT/include/sys/mman.h"; then
    cat >> "$SYSROOT/include/sys/mman.h" << 'EOF'

/* lane-C1 freestanding shims: LLVM Support/Unix/Memory.inc. */
#ifndef _SIMPLEOS_MMAN_LANEC1
#define _SIMPLEOS_MMAN_LANEC1
#ifdef __cplusplus
extern "C" {
#endif
int madvise(void *addr, size_t length, int advice);
int posix_madvise(void *addr, size_t length, int advice);
#ifdef __cplusplus
}
#endif
#endif
EOF
fi
if ! grep -q "MADV_DONTNEED" "$SYSROOT/include/sys/mman.h"; then
    cat >> "$SYSROOT/include/sys/mman.h" << 'EOF'

#ifndef _SIMPLEOS_MMAN_CONSTS_LANEC1
#define _SIMPLEOS_MMAN_CONSTS_LANEC1
#define MADV_NORMAL      0
#define MADV_RANDOM      1
#define MADV_SEQUENTIAL  2
#define MADV_WILLNEED    3
#define MADV_DONTNEED    4
#define MADV_FREE        8
#endif
EOF
fi
if ! grep -q "_SC_ARG_MAX" "$SYSROOT/include/unistd.h"; then
    cat >> "$SYSROOT/include/unistd.h" << 'EOF'

#ifndef _SIMPLEOS_UNISTD_CONSTS_LANEC1
#define _SIMPLEOS_UNISTD_CONSTS_LANEC1
#define _SC_ARG_MAX   0
#define _SC_PAGESIZE  30
#define _SC_PAGE_SIZE 30
#define _POSIX_ARG_MAX 4096
#endif
EOF
fi
if ! grep -q "SA_NODEFER" "$SYSROOT/include/signal.h"; then
    cat >> "$SYSROOT/include/signal.h" << 'EOF'

#ifndef _SIMPLEOS_SIGNAL_CONSTS_LANEC1
#define _SIMPLEOS_SIGNAL_CONSTS_LANEC1
#define SA_NOCLDSTOP 0x00000001
#define SA_NOCLDWAIT 0x00000002
#define SA_SIGINFO   0x00000004
#define SA_ONSTACK   0x08000000
#define SA_RESTART   0x10000000
#define SA_NODEFER   0x40000000
#define SA_RESETHAND 0x80000000
#define SA_NOMASK    SA_NODEFER
#define SA_ONESHOT   SA_RESETHAND
#endif
EOF
fi
mkdir -p "$LIBC_BUILD"
cat > "$LIBC_BUILD/libcxx_compat.c" << 'EOF'
/* lane-C1 freestanding shims — narrow-and-delegate fallbacks for the
   strtold/wcstod family missing from SimpleOS libc at this commit.
   Long-double precision is NOT honored (strtod-backed); the real
   implementations are a SimpleOS libc gap to fix upstream. */
#include <stdlib.h>
#include <wchar.h>
#include <pthread.h>
#include <string.h>

long double strtold(const char *nptr, char **endptr) {
    return (long double)strtod(nptr, endptr);
}

static double wcstod_narrow(const wchar_t *nptr, wchar_t **endptr, int is_float, int is_long_double) {
    char buf[128];
    size_t i = 0;
    while (nptr[i] != 0 && i < sizeof(buf) - 1) {
        if (nptr[i] > 127) break;
        buf[i] = (char)nptr[i];
        i++;
    }
    buf[i] = 0;
    char *end_n = 0;
    double v = strtod(buf, &end_n);
    if (endptr) *endptr = (wchar_t *)(nptr + (end_n ? (size_t)(end_n - buf) : 0));
    (void)is_float; (void)is_long_double;
    return v;
}

double wcstod(const wchar_t *nptr, wchar_t **endptr) {
    return wcstod_narrow(nptr, endptr, 0, 0);
}

float wcstof(const wchar_t *nptr, wchar_t **endptr) {
    return (float)wcstod_narrow(nptr, endptr, 1, 0);
}

long double wcstold(const wchar_t *nptr, wchar_t **endptr) {
    return (long double)wcstod_narrow(nptr, endptr, 0, 1);
}

int pthread_mutexattr_settype(pthread_mutexattr_t *attr, int type) {
    (void)attr; (void)type;
    return 0;
}

#include <errno.h>
#include <sys/wait.h>
#include <sys/resource.h>

/* No symlinks on SimpleOS today; LLVM only reaches this when /proc/self/fd
   exists, which it does not (access() gate in Path.inc). */
ssize_t readlink(const char *path, char *buf, size_t bufsize) {
    (void)path; (void)buf; (void)bufsize;
    errno = EINVAL;
    return -1;
}

/* wait4 is not in SimpleOS libc (waitpid is); rusage is best-effort zero. */
pid_t wait4(pid_t pid, int *wstatus, int options, struct rusage *rusage) {
    pid_t rc = waitpid(pid, wstatus, options);
    if (rusage) {
        rusage->ru_utime.tv_sec = 0; rusage->ru_utime.tv_usec = 0;
        rusage->ru_stime.tv_sec = 0; rusage->ru_stime.tv_usec = 0;
    }
    return rc;
}

char *strerror_r(int errnum, char *buf, unsigned long buflen) {
    const char *msg = strerror(errnum);
    unsigned long i = 0;
    if (!buf || buflen == 0) return buf;
    while (msg[i] != 0 && i < buflen - 1) {
        buf[i] = msg[i];
        i++;
    }
    buf[i] = 0;
    return buf;
}

/* Advisory/stub fallbacks for POSIX entry points SimpleOS libc lacks at this
   commit (checked NOIMPL against libsimpleos_c.a). Guest-visible no-ops. */
int fchmod(int fd, unsigned int mode) { (void)fd; (void)mode; return 0; }
int fchown(int fd, unsigned int owner, unsigned int group) { (void)fd; (void)owner; (void)group; return 0; }
int futimens(int fd, const void *times) { (void)fd; (void)times; return 0; }
int getpagesize(void) { return 4096; }
int link(const char *oldpath, const char *newpath) { (void)oldpath; (void)newpath; errno = ENOSYS; return -1; }
int symlink(const char *target, const char *linkpath) { (void)target; (void)linkpath; errno = ENOSYS; return -1; }
int madvise(void *addr, size_t length, int advice) { (void)addr; (void)length; (void)advice; return 0; }
int posix_madvise(void *addr, size_t length, int advice) { (void)addr; (void)length; (void)advice; return 0; }
ssize_t sbrk(ssize_t increment) { (void)increment; errno = ENOMEM; return -1; }
unsigned int umask(unsigned int mask) { (void)mask; return 0; }

/* vfprintf: no va_list core in SimpleOS libc; format into a stack buffer
   via vsnprintf and emit through fputs (single-console OS). */
int vfprintf(FILE *stream, const char *fmt, va_list ap) {
    char buf[1024];
    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
    fputs(buf, stream);
    return n;
}

long wcstol(const wchar_t *nptr, wchar_t **endptr, int base) {
    char buf[128]; size_t i = 0;
    while (nptr[i] != 0 && i < sizeof(buf) - 1) { if (nptr[i] > 127) break; buf[i] = (char)nptr[i]; i++; }
    buf[i] = 0;
    char *end_n = 0;
    long v = strtol(buf, &end_n, base);
    if (endptr) *endptr = (wchar_t *)(nptr + (end_n ? (size_t)(end_n - buf) : 0));
    return v;
}
unsigned long wcstoul(const wchar_t *nptr, wchar_t **endptr, int base) {
    char buf[128]; size_t i = 0;
    while (nptr[i] != 0 && i < sizeof(buf) - 1) { if (nptr[i] > 127) break; buf[i] = (char)nptr[i]; i++; }
    buf[i] = 0;
    char *end_n = 0;
    unsigned long v = strtoul(buf, &end_n, base);
    if (endptr) *endptr = (wchar_t *)(nptr + (end_n ? (size_t)(end_n - buf) : 0));
    return v;
}
long long wcstoll(const wchar_t *nptr, wchar_t **endptr, int base) {
    return (long long)wcstol(nptr, endptr, base);
}
unsigned long long wcstoull(const wchar_t *nptr, wchar_t **endptr, int base) {
    return (unsigned long long)wcstoul(nptr, endptr, base);
}
/* swprintf for libc++ std::to_wstring paths (single-console OS). */
#include <stdarg.h>
int swprintf(wchar_t *str, size_t n, const wchar_t *fmt, ...) {
    char fbuf[256], obuf[1024];
    size_t i = 0;
    while (fmt[i] && i < sizeof(fbuf) - 1) { if (fmt[i] > 127) break; fbuf[i] = (char)fmt[i]; i++; }
    fbuf[i] = 0;
    va_list ap;
    va_start(ap, fmt);
    int r = vsnprintf(obuf, sizeof(obuf), fbuf, ap);
    va_end(ap);
    size_t j = 0;
    if (str && n) {
        for (; obuf[j] && j + 1 < n; j++) str[j] = (wchar_t)(unsigned char)obuf[j];
        str[j] = 0;
    }
    return r;
}

/* Minimal single-locale API + restartable converters (libc++ __locale). */
#include <locale.h>
locale_t newlocale(int mask, const char *name, locale_t base) { (void)mask; (void)name; return base ? base : (locale_t)1; }
locale_t duplocale(locale_t loc) { return loc; }
void freelocale(locale_t loc) { (void)loc; }
locale_t uselocale(locale_t loc) { return loc; }
size_t mbsrtowcs(wchar_t *dst, const char **src, size_t len, void *ps) {
    (void)ps; if (!src || !*src) return (size_t)-1; const char *s = *src; size_t n = 0;
    if (!dst) { while (s[n]) n++; return n; }
    while (n < len && s[n]) { dst[n] = (wchar_t)(unsigned char)s[n]; n++; }
    if (n < len) { dst[n] = 0; *src = s + n; } return n;
}
size_t wcsrtombs(char *dst, const wchar_t **src, size_t len, void *ps) {
    (void)ps; if (!src || !*src) return (size_t)-1; const wchar_t *s = *src; size_t n = 0;
    if (!dst) { while (s[n]) n++; return n; }
    while (n < len && s[n]) { if (s[n] > 127) return (size_t)-1; dst[n] = (char)s[n]; n++; }
    if (n < len) { dst[n] = 0; *src = s + n; } return n;
}
size_t mbsnrtowcs(wchar_t *dst, const char **src, size_t nms, size_t len, void *ps) {
    (void)ps; if (!src || !*src) return (size_t)-1; const char *s = *src; size_t n = 0, avail = 0;
    while (avail < nms && s[avail]) avail++;
    if (!dst) return avail;
    while (n < len && n < avail) { dst[n] = (wchar_t)(unsigned char)s[n]; n++; }
    if (n < len && n == avail) { dst[n] = 0; *src = s + n; } return n;
}
size_t wcsnrtombs(char *dst, const wchar_t **src, size_t nwc, size_t len, void *ps) {
    (void)ps; if (!src || !*src) return (size_t)-1; const wchar_t *s = *src; size_t n = 0, avail = 0;
    while (avail < nwc && s[avail]) avail++;
    if (!dst) return avail;
    while (n < len && n < avail) { if (s[n] > 127) return (size_t)-1; dst[n] = (char)s[n]; n++; }
    if (n < len && n == avail) { dst[n] = 0; *src = s + n; } return n;
}
/* libc++ bsd locale fallback impls. */
#include <stdio.h>
#include <locale.h>
int vasprintf(char **strp, const char *fmt, va_list ap) {
    va_list ap2;
    va_copy(ap2, ap);
    int n = vsnprintf(NULL, 0, fmt, ap2);
    va_end(ap2);
    if (n < 0) return n;
    char *buf = (char *)malloc((size_t)n + 1);
    if (!buf) return -1;
    vsnprintf(buf, (size_t)n + 1, fmt, ap);
    *strp = buf;
    return n;
}
int vsscanf(const char *str, const char *fmt, va_list ap) {
    (void)str; (void)fmt; (void)ap;
    return EOF;
}int vsscanf(const char *str, const char *fmt, va_list ap) {
    (void)str; (void)fmt; (void)ap;
    return EOF;
}

/* *_l locale variants: single-locale delegates (libc++ locale_base_api). */
float strtof_l(const char *nptr, char **endptr, locale_t loc) { (void)loc; return strtof(nptr, endptr); }
double strtod_l(const char *nptr, char **endptr, locale_t loc) { (void)loc; return strtod(nptr, endptr); }
long double strtold_l(const char *nptr, char **endptr, locale_t loc) { (void)loc; return strtold(nptr, endptr); }
long long strtoll_l(const char *nptr, char **endptr, int base, locale_t loc) { (void)loc; return (long long)strtol(nptr, endptr, base); }
unsigned long long strtoull_l(const char *nptr, char **endptr, int base, locale_t loc) { (void)loc; return (unsigned long long)strtoul(nptr, endptr, base); }
int strcoll_l(const char *a, const char *b, locale_t loc) { (void)loc; return strcmp(a, b); }
size_t strxfrm_l(char *dst, const char *src, size_t n, locale_t loc) {
    (void)loc; size_t len = strlen(src);
    if (dst && n) { strncpy(dst, src, n - 1); dst[n - 1] = 0; }
    return len;
}
size_t strftime_l(char *s, size_t max, const char *fmt, const struct tm *tmv, locale_t loc) {
    (void)loc; return strftime(s, max, fmt, tmv);
}
int wcscoll_l(const wchar_t *a, const wchar_t *b, locale_t loc) { (void)loc; return wcscmp(a, b); }
size_t wcsxfrm_l(wchar_t *dst, const wchar_t *src, size_t n, locale_t loc) {
    (void)loc; size_t len = wcslen(src);
    if (dst && n) { size_t i = 0; for (; src[i] && i + 1 < n; i++) dst[i] = src[i]; dst[i] = 0; }
    return len;
}
EOF
"$CC" --target=x86_64-unknown-none-elf \
    -ffreestanding -nostdlib -fno-builtin -mno-red-zone \
    -fno-stack-protector -fno-exceptions -fno-unwind-tables \
    -fno-asynchronous-unwind-tables -O2 -I "$SYSROOT/include" \
    -c "$LIBC_BUILD/libcxx_compat.c" -o "$LIBC_BUILD/libcxx_compat.o"
echo "[sysroot-mirror] libc++ compat shims compiled (appended to libsimpleos_c.a after libc build)"

# -- Libc (x86_64 branch; out-of-tree copy instead of in-tree make) ----------
echo "[sysroot-mirror] Building SimpleOS libc (out-of-tree copy of $LIBC_DIR)..."
rm -rf "$LIBC_BUILD/src"
cp -R "$LIBC_DIR" "$LIBC_BUILD/src"
(cd "$LIBC_BUILD/src" && make -j "$SIMPLE_BUILD_JOBS")
# Pre-existing libc duplicate: simpleos_pthread.o and simpleos_pthread_cond.o
# both define the pthread_cond family; localize the copies in pthread.o so the
# dedicated cond TU (superset: adds timedwait) is the unique global provider.
if command -v llvm-objcopy >/dev/null 2>&1; then
    llvm-objcopy --localize-symbol=pthread_cond_init --localize-symbol=pthread_cond_destroy \
        --localize-symbol=pthread_cond_signal --localize-symbol=pthread_cond_broadcast \
        --localize-symbol=pthread_cond_wait --localize-symbol=pthread_condattr_init \
        --localize-symbol=pthread_condattr_destroy "$LIBC_BUILD/src/simpleos_pthread.o"
    (cd "$LIBC_BUILD/src" && "$AR" r libsimpleos_c.a simpleos_pthread.o)
    echo "[sysroot-mirror] Localized duplicate pthread_cond_* in simpleos_pthread.o"
fi
cp "$LIBC_BUILD/src/libsimpleos_c.a" "$SYSROOT/lib/libsimpleos_c.a"
cp "$LIBC_BUILD/src/simpleos_crt0.o" "$SYSROOT/lib/crt0.o"
if [ -f "$LIBC_BUILD/libcxx_compat.o" ]; then
    "$AR" r "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD/libcxx_compat.o"
    echo "[sysroot-mirror] Appended libc++ compat shims to libsimpleos_c.a"
fi
# libm.a: the toolchain link line references -lm but no step at this commit
# produces it (math lives in libsimpleos_c.a). Ship a placeholder archive.
if [ ! -f "$SYSROOT/lib/libm.a" ]; then
    printf 'int __simpleos_libm_placeholder;\n' > "$LIBC_BUILD/libm_placeholder.c"
    "$CC" --target=x86_64-unknown-none-elf -ffreestanding -nostdlib \
        -c "$LIBC_BUILD/libm_placeholder.c" -o "$LIBC_BUILD/libm_placeholder.o"
    "$AR" rcs "$SYSROOT/lib/libm.a" "$LIBC_BUILD/libm_placeholder.o"
    echo "[sysroot-mirror] Installed placeholder libm.a"
fi
# Empty system-library placeholders: LLVM's cmake appends -lpthreads -lrt
# -ldl (-lzircon via the FUCHSIA LLVM_ON_UNIX knob) to Support consumers;
# the real symbols live in libsimpleos_c.a / are unused in this port.
for l in libpthreads librt libdl libzircon; do
    if [ ! -f "$SYSROOT/lib/$l.a" ]; then
        printf 'int __simpleos_%s_placeholder;\n' "${l#lib}" > "$LIBC_BUILD/${l#lib}_placeholder.c"
        "$CC" --target=x86_64-unknown-none-elf -ffreestanding -nostdlib \
            -c "$LIBC_BUILD/${l#lib}_placeholder.c" -o "$LIBC_BUILD/${l#lib}_placeholder.o"
        "$AR" rcs "$SYSROOT/lib/$l.a" "$LIBC_BUILD/${l#lib}_placeholder.o"
        echo "[sysroot-mirror] Installed placeholder $l.a"
    fi
done
# main shim: freestanding C++ TUs emit mangled _Z4mainv while crt0.o calls
# plain C main. Weak-main archive member resolves the C++ case; C programs
# override it with their strong main and the member stays unpulled.
if ! llvm-ar t "$SYSROOT/lib/libsimpleos_c.a" 2>/dev/null | grep -q "main_shim"; then
    cat > "$LIBC_BUILD/main_shim.S" << 'EOF'
/* lane-C1: freestanding C++ emits _Z4mainv; crt0.o references C main. */
    .weak _Z4mainv
    .weak main
    .type main, @function
main:
    jmp _Z4mainv
    .size main, .-main
EOF
    "$CC" --target=x86_64-unknown-none-elf -ffreestanding -nostdlib \
        -c "$LIBC_BUILD/main_shim.S" -o "$LIBC_BUILD/main_shim.o"
    "$AR" r "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD/main_shim.o"
    echo "[sysroot-mirror] Appended main_shim.o to libsimpleos_c.a"
fi

"$CC" --target=x86_64-unknown-none-elf \
    -ffreestanding -nostdlib -fno-builtin -mno-red-zone \
    -fno-stack-protector -ffunction-sections -fdata-sections -O2 \
    -c "$LIBC_DIR/simpleos_entry.c" -o "$SYSROOT/lib/simple_entry.o"

echo "[sysroot-mirror] Building SimpleOS Simple runtime ABI..."
RT_ABI="$LIBC_BUILD/simpleos_simple_runtime.o"
"$CC" --target=x86_64-unknown-none-elf \
    -ffreestanding -nostdlib -fno-builtin -mno-red-zone \
    -fno-stack-protector -fno-exceptions -fno-unwind-tables \
    -fno-asynchronous-unwind-tables -ffunction-sections \
    -fdata-sections -O2 -Wall -Wextra -Wno-unused-parameter \
    -I "$LIBC_DIR/include" \
    -c "$LIBC_DIR/simpleos_simple_runtime.c" -o "$RT_ABI"
rm -f "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"
"$AR" rcs "$SYSROOT/lib/libsimple_runtime_compat.a" "$RT_ABI"
cp "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"

echo "[sysroot-mirror] Cross-compiling Simple runtime sources for $TRIPLE..."
echo "[sysroot-mirror] NOTE: runtime_native.c is EXCLUDED at current Simple HEAD (repo drift:"
echo "[sysroot-mirror]  needs -DSIMPLE_RUNTIME_FREESTANDING_V2 AND runtime_fd_stat_v1.h reads"
echo "[sysroot-mirror]  glibc st_mtim/st_ctim which SimpleOS struct stat lacks; mkdtemp/link"
echo "[sysroot-mirror]  undeclared). Not consumed by the clang lanes; see report finding."
RT_BUILD="$LIBC_BUILD/simple_runtime_native"
mkdir -p "$RT_BUILD"
RT_CFLAGS="--target=x86_64-unknown-none-elf -ffreestanding -nostdlib \
    -nostdlibinc -fno-builtin -mno-red-zone -fno-stack-protector \
    -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
    -ffunction-sections -fdata-sections -O2 -D__simpleos__=1 \
    -DSIMPLE_RUNTIME_FREESTANDING_V2 -Wno-implicit-function-declaration \
    -isystem $LIBC_DIR/include"
RT_OBJS=""
RT_FAILED=""
for rt_src in runtime_legacy_core runtime_simd_utf8 runtime_contracts \
              runtime_memory runtime_time runtime_timestamp \
              runtime_pool runtime_memtrack \
              runtime_simpleos_syscall_adapters \
              startup/baremetal/runtime_port_io \
              startup/baremetal/runtime_log
do
    rt_obj="$RT_BUILD/$(basename "$rt_src").o"
    if "$CC" $RT_CFLAGS -c "$REPO_ROOT/src/runtime/$rt_src.c" -o "$rt_obj"; then
        RT_OBJS="$RT_OBJS $rt_obj"
    else
        echo "[sysroot-mirror] WARNING: skipping failed runtime source: $rt_src.c"
        RT_FAILED="$RT_FAILED $rt_src"
    fi
done
rm -f "$SYSROOT/lib/libsimple_runtime_native.a"
"$AR" rcs "$SYSROOT/lib/libsimple_runtime_native.a" $RT_OBJS
cp "$SYSROOT/lib/libsimple_runtime_native.a" "$SYSROOT/lib/libsimple_runtime.a"
echo "[sysroot-mirror] Built libsimple_runtime_native.a ($(echo $RT_OBJS | wc -w) members) skipped/failed:${RT_FAILED:- none}"

# -- libc++ runtime (same source list + flags as sysroot.shs) -----------------
if [ ! -d "$LLVM_SRC/libcxx/src" ]; then
    echo "[sysroot-mirror] NOTE: libc++ sources not found at $LLVM_SRC/libcxx/src"
else
    echo "[sysroot-mirror] Building libc++.a for $TRIPLE..."
    mkdir -p "$LIBCXX_BUILD"
    LIBCXX_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -std=c++23 -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -fsized-deallocation -D__simpleos__=1 -DLIBC_NAMESPACE=__llvm_libc -D_LIBCPP_BUILDING_LIBRARY -D_LIBCPP_BUILDING_HAS_NO_ABI_LIBRARY -D_LIBCPP_REMOVE_TRANSITIVE_INCLUDES -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS= -D_LIBCPP_PSTL_BACKEND_SERIAL=1 -D_LIBCPP_HAS_CLOCK_GETTIME=1 -I$LLVM_SRC/libcxx/src -I$LLVM_SRC/libc -isystem $SYSROOT/include/c++/v1 -isystem $SYSROOT/include"
    for src in \
        new.cpp algorithm.cpp any.cpp bind.cpp call_once.cpp charconv.cpp chrono.cpp \
        error_category.cpp exception.cpp expected.cpp \
        filesystem/filesystem_clock.cpp filesystem/filesystem_error.cpp \
        filesystem/path.cpp functional.cpp hash.cpp memory.cpp \
        memory_resource.cpp new_handler.cpp new_helpers.cpp optional.cpp \
        print.cpp random.cpp random_shuffle.cpp ryu/d2fixed.cpp ryu/d2s.cpp \
        ryu/f2s.cpp stdexcept.cpp string.cpp system_error.cpp typeinfo.cpp \
        valarray.cpp variant.cpp vector.cpp verbose_abort.cpp \
        atomic.cpp barrier.cpp condition_variable_destructor.cpp \
        condition_variable.cpp future.cpp mutex_destructor.cpp mutex.cpp \
        shared_mutex.cpp thread.cpp
    do
        obj="$LIBCXX_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
        mkdir -p "$(dirname "$obj")"
        "$CXX" $LIBCXX_FLAGS -c "$LLVM_SRC/libcxx/src/$src" -o "$obj"
    done
    rm -f "$SYSROOT/lib/libc++.a"
    "$AR" rcs "$SYSROOT/lib/libc++.a" "$LIBCXX_BUILD"/*.o
    echo "[sysroot-mirror] Installed libc++.a"
fi

# -- libc++abi (no-exceptions config) -----------------------------------------
if [ -d "$LLVM_SRC/libcxxabi/src" ]; then
    echo "[sysroot-mirror] Building libc++abi.a (no-exceptions) for $TRIPLE..."
    mkdir -p "$LIBCXXABI_BUILD"
    LIBCXXABI_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -std=c++23 -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -fstrict-aliasing -D__simpleos__=1 -D_LIBCPP_BUILDING_LIBRARY -DHAVE___CXA_THREAD_ATEXIT_IMPL=0 -I$LLVM_SRC/libcxxabi/include -I$LLVM_SRC/libcxxabi/src -I$LLVM_SRC/libcxx/src -isystem $SYSROOT/include/c++/v1 -isystem $SYSROOT/include"
    for src in \
        cxa_aux_runtime.cpp cxa_default_handlers.cpp cxa_demangle.cpp \
        cxa_exception_storage.cpp cxa_guard.cpp cxa_handlers.cpp \
        cxa_vector.cpp cxa_virtual.cpp cxa_noexception.cpp \
        stdlib_exception.cpp stdlib_stdexcept.cpp stdlib_typeinfo.cpp \
        abort_message.cpp fallback_malloc.cpp private_typeinfo.cpp
    do
        obj="$LIBCXXABI_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
        PERFILE_FLAGS="$LIBCXXABI_FLAGS"
        case "$src" in
            private_typeinfo.cpp) PERFILE_FLAGS="$(printf '%s' "$LIBCXXABI_FLAGS" | sed 's/-fno-rtti/-frtti/')" ;;
        esac
        "$CXX" $PERFILE_FLAGS -c "$LLVM_SRC/libcxxabi/src/$src" -o "$obj"
    done
    rm -f "$SYSROOT/lib/libc++abi.a"
    "$AR" rcs "$SYSROOT/lib/libc++abi.a" "$LIBCXXABI_BUILD"/*.o
    echo "[sysroot-mirror] Installed libc++abi.a"
fi

# -- libunwind -----------------------------------------------------------------
if [ -d "$LLVM_SRC/libunwind/src" ]; then
    echo "[sysroot-mirror] Building libunwind.a for $TRIPLE..."
    mkdir -p "$LIBUNWIND_BUILD"
    LIBUNWIND_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -D__simpleos__=1 -D_LIBUNWIND_IS_BAREMETAL -D_LIBUNWIND_HAS_NO_THREADS -I$LLVM_SRC/libunwind/include -isystem $SYSROOT/include"
    for src in libunwind.cpp UnwindLevel1.c UnwindLevel1-gcc-ext.c Unwind-sjlj.c; do
        obj="$LIBUNWIND_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
        case "$src" in
            *.cpp) "$CXX" -std=c++17 $LIBUNWIND_FLAGS -c "$LLVM_SRC/libunwind/src/$src" -o "$obj" ;;
            *.c)   "$CC" $LIBUNWIND_FLAGS -c "$LLVM_SRC/libunwind/src/$src" -o "$obj" ;;
        esac
    done
    rm -f "$SYSROOT/lib/libunwind.a"
    "$AR" rcs "$SYSROOT/lib/libunwind.a" "$LIBUNWIND_BUILD"/*.o
    echo "[sysroot-mirror] Installed libunwind.a"
fi

# -- CRT + linker script (same heredoc as sysroot.shs) -------------------------
if [ -f "$LIBC_BUILD/src/simpleos_crt0.o" ]; then
    cp "$LIBC_BUILD/src/simpleos_crt0.o" "$SYSROOT/lib/crt0.o"
    echo "[sysroot-mirror] Installed crt0.o"
fi

cat > "$SYSROOT/share/simpleos/simpleos.ld" << 'LDEOF'
/* SimpleOS x86_64 userspace linker script
 *
 * Text starts at 0x10000000 — matches kernel bump allocator base.
 * Static linking only (no GOT/PLT).
 */
ENTRY(_start)

SECTIONS {
    . = 0x10000000;

    .text : {
        *(.text.entry)
        *(.text .text.*)
    }

    . = ALIGN(4096);
    .rodata : {
        *(.rodata .rodata.*)
    }

    . = ALIGN(4096);
    .data : {
        *(.data .data.*)
        *(.sdata .sdata.*)
    }

    . = ALIGN(16);
    .init_array : {
        __init_array_start = .;
        KEEP(*(.init_array .init_array.*))
        __init_array_end = .;
    }

    . = ALIGN(16);
    .fini_array : {
        __fini_array_start = .;
        KEEP(*(.fini_array .fini_array.*))
        __fini_array_end = .;
    }

    . = ALIGN(16);
    .tdata : {
        _tls_start = .;
        *(.tdata .tdata.*)
    }

    . = ALIGN(16);
    .tbss : {
        *(.tbss .tbss.*)
        _tls_end = .;
    }

    . = ALIGN(4096);
    .bss : {
        __bss_start = .;
        *(.bss .bss.*)
        *(.sbss .sbss.*)
        *(COMMON)
        __bss_end = .;
    }

    _end = .;

    /DISCARD/ : {
        *(.comment)
        *(.note .note.*)
        *(.eh_frame)
        *(.eh_frame_hdr)
        *(.got)
        *(.got.plt)
        *(.plt)
        *(.rela.plt)
    }
}
LDEOF
echo "[sysroot-mirror] Installed linker script"
printf '%s\n' "$TRIPLE" > "$SYSROOT/share/simpleos/target-triple.txt"

echo "[sysroot-mirror] Sysroot ready: $SYSROOT"
ls -la "$SYSROOT/lib/"
