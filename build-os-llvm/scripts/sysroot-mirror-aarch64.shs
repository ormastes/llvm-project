#!/bin/sh
# AArch64 sysroot for lane C1 (aarch64 variant).
# Header tree: cloned from the verified x86_64 sysroot (shim content is
# arch-independent C declarations; __config_site/v1 libc++ headers identical).
# libc/crt0/runtime: mirrors src/os/port/llvm/sysroot.shs aarch64 branch
# (direct per-file compiles; aarch64 crt0/syscall/setjmp .S heredocs — the
# repo has NO examples/09_embedded arm64 crt0, so the sysroot.shs heredoc crt0
# is the source; RECORDED adaptation).
set -e

REPO_ROOT=/home/yoon/dev/simple          # read-only inputs only
LIBC_DIR="$REPO_ROOT/src/os/libc"
WORK=/home/yoon/llvm-project-simpleos/build-os-llvm
LLVM_SRC=/home/yoon/llvm-project-simpleos
SYSROOT="$WORK/sysroot-aarch64"
TRIPLE=aarch64-unknown-simpleos
SIMPLE_BUILD_JOBS=${SIMPLEOS_JOBS:-20}
LIBC_BUILD="$WORK/libc-build-aarch64"
LIBCXX_BUILD="$WORK/libcxx-aarch64-unknown-simpleos"
LIBCXXABI_BUILD="$WORK/libcxxabi-aarch64-unknown-simpleos"
LIBUNWIND_BUILD="$WORK/libunwind-aarch64-unknown-simpleos"

CC="${CC:-clang}"
CXX="${CXX:-clang++}"
if command -v llvm-ar >/dev/null 2>&1; then AR=llvm-ar; else AR=ar; fi

echo "[sysroot-aarch64] Building SimpleOS sysroot at $SYSROOT (triple $TRIPLE)"
mkdir -p "$SYSROOT/lib" "$SYSROOT/share/simpleos"
rm -f "$SYSROOT/share/simpleos/target-triple.txt"

# -- libc++ headers: staged from the fork on every run (same commands as
#    sysroot-mirror.shs). The previous one-time manual clone silently rotted
#    when the fork's libcxx headers were granularized (2026-09-25:
#    memory_resource.cpp needs the templated __libcpp_allocate from the new
#    <new>/__new/allocate.h; the stale monolithic header broke the libc++
#    build). __config_site is the lane-C1 pinned generated config from the
#    original staging — do not overwrite it here.
if [ -d "$LLVM_SRC/libcxx/include" ]; then
    mkdir -p "$SYSROOT/include/c++/v1"
    cp -R "$LLVM_SRC/libcxx/include/." "$SYSROOT/include/c++/v1/"
    cp "$LLVM_SRC/libcxx/vendor/llvm/default_assertion_handler.in" \
        "$SYSROOT/include/c++/v1/__assertion_handler"
    echo "[sysroot-aarch64] Staged libc++ headers from fork libcxx/include"
fi

# -- libc (aarch64 branch of sysroot.shs) ------------------------------------
echo "[sysroot-aarch64] Building SimpleOS libc for $TRIPLE..."
mkdir -p "$LIBC_BUILD"
CFLAGS="--target=$TRIPLE --sysroot=$SYSROOT -ffreestanding -nostdlib -fno-builtin -fno-stack-protector -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -O2 -Wall -Wextra -Wno-unused-parameter -D__simpleos__=1 -I$LIBC_DIR/include"
# RECORDED adaptation: guest single-threaded mutex semantics. The repo libc
# deliberately stubs the mutex family as ENOSYS ("until a kernel-owned atomic
# mutex/futex handoff exists"). But LLVM's SmartMutex ALWAYS embeds a
# std::recursive_mutex (LLVM_ENABLE_THREADS=0 only skips locking at runtime;
# construction still runs pthread_mutex_init), so libc++'s recursive_mutex
# ctor throws system_error(ENOSYS) in -fno-exceptions mode and the guest
# driver aborts (rc=134) inside PrintStackTraceOnErrorSignal
# (Signals.inc ManagedStatic<sys::SmartMutex<true>> Lock). Ring-3 payloads
# have no threads (no clone syscall; pthread_create stays ENOSYS), so no-op
# mutexes are indistinguishable from real ones here — same precedent as the
# lane's pread shim ("matching single-process SimpleOS semantics").
# pthread_create/join/detach and the attr/cond families keep their ENOSYS.
cp "$LIBC_DIR/simpleos_pthread.c" "$LIBC_BUILD/simpleos_pthread.c"
sed -i -e '/^int pthread_mutex_init/,/^}/ s/return ENOSYS;/return 0;/' \
       -e 's/return mutex ? ENOSYS : EINVAL;/return mutex ? 0 : EINVAL;/' \
    "$LIBC_BUILD/simpleos_pthread.c"
grep -q 'return mutex ? 0 : EINVAL;' "$LIBC_BUILD/simpleos_pthread.c" \
    || { echo "[sysroot-aarch64] ERROR: pthread mutex guest patch did not apply"; exit 1; }
# fstat: NO guest patch — the repo's real syscall fstat (a3=1 fd-mode) is
# the source of truth. The arm64 kernel's id-34 handler answers fd-mode
# from its fd table (S_IFREG + real size; stdio fds 0/1/2 zeroed). The
# previous zeroed-stub patch here was the R5b root cause: clang's
# MemoryBuffer::getOpenFile trusts st_size=0, so the guest cc1 compiled an
# empty translation unit (no read syscall at all) and the in-guest-linked
# product lost main/printf (hollow rc=0 green).
cp "$LIBC_DIR/simpleos_fs.c" "$LIBC_BUILD/simpleos_fs.c"
for src in \
    simpleos_libc.c simpleos_math.c simpleos_math_ext.c simpleos_fs.c \
    simpleos_pthread.c simpleos_alloc.c simpleos_process.c \
    simpleos_string_ext.c simpleos_stdlib_ext.c \
    simpleos_time.c simpleos_printf_float.c simpleos_cxxabi.c \
    simpleos_dlmalloc.c simpleos_signal.c simpleos_libc_ext.c \
    simpleos_poll.c simpleos_process_wait.c \
    simpleos_pthread_rwlock.c simpleos_pthread_cond.c \
    simpleos_sched.c simpleos_epoll.c simpleos_eventfd.c \
    simpleos_timerfd.c simpleos_signalfd.c simpleos_inotify.c \
    simpleos_fs_walk.c simpleos_glob_stub.c simpleos_pwd_stub.c \
    simpleos_strfmon.c simpleos_fork.c simpleos_ipc.c \
    simpleos_socket.c simpleos_filelock.c simpleos_statvfs.c \
    simpleos_utsname.c
do
    src_path="$LIBC_DIR/$src"
    extra_inc=""
    if [ "$src" = "simpleos_pthread.c" ]; then
        src_path="$LIBC_BUILD/simpleos_pthread.c"
        extra_inc="-I$LIBC_DIR"  # patched copy keeps the repo's "include/..." quoted includes
    fi
    if [ "$src" = "simpleos_fs.c" ]; then
        src_path="$LIBC_BUILD/simpleos_fs.c"
        extra_inc="-I$LIBC_DIR"
    fi
    "$CC" $CFLAGS $extra_inc -c "$src_path" -o "$LIBC_BUILD/${src%.c}.o"
done

# crt0: the repo's current simpleos_crt0_aarch64.S is the source of truth.
# It reads the SysV process-entry stack frame the kernel builds
# (sp[0]=argc, sp[1..]=argv, then envp; falls back to 0/NULL for early
# kernels), zeroes BSS, publishes environ/argc/argv, runs
# __libc_init_array, then calls main(argc, argv, envp) and exit(ret).
# The previous heredoc predated that source and called main(0, 0, 0)
# (bug: guest_aarch64_clang_lld_mislinked_crt0_main_pread_wall10_2026-09-26).
cp "$LIBC_DIR/simpleos_crt0_aarch64.S" "$LIBC_BUILD/simpleos_crt0_aarch64.S"
# RECORDED adaptation: the repo aarch64 crt0 still carries the pre-fix
# `.globl environ` definition, which ld.lld rejects as a duplicate symbol
# against libc's strong `char **environ = _env_storage;`
# (simpleos_process.c) — the exact collision the x86_64 crt0
# (src/os/libc/simpleos_crt0.S, "History, both directions of this trap")
# already resolved with `.weak environ`. Mirror that resolution here until
# the repo source catches up; do not promote back to .globl.
sed -i 's/^    \.globl environ$/    .weak environ/' "$LIBC_BUILD/simpleos_crt0_aarch64.S"
grep -q '^    \.weak environ$' "$LIBC_BUILD/simpleos_crt0_aarch64.S" \
    || { echo "[sysroot-aarch64] ERROR: crt0 environ weakification did not apply"; exit 1; }
cat > "$LIBC_BUILD/simpleos_syscall_aarch64.S" << 'ASMEOF'
.section .text
.global simpleos_syscall
.type simpleos_syscall, %function
simpleos_syscall:
    mov x8, x0
    mov x0, x1
    mov x1, x2
    mov x2, x3
    mov x3, x4
    mov x4, x5
    svc #0
    ret
.size simpleos_syscall, . - simpleos_syscall

.global __clear_cache
.type __clear_cache, %function
__clear_cache:
    ret
.size __clear_cache, . - __clear_cache
ASMEOF
cat > "$LIBC_BUILD/simpleos_setjmp_aarch64.S" << 'ASMEOF'
.section .text
.global setjmp
.type setjmp, %function
setjmp:
    stp x19, x20, [x0, #0]
    stp x21, x22, [x0, #16]
    stp x23, x24, [x0, #32]
    stp x29, x30, [x0, #48]
    mov x1, sp
    str x1, [x0, #64]
    mov x0, #0
    ret
.size setjmp, . - setjmp

.global _setjmp
.type _setjmp, %function
_setjmp:
    b setjmp
.size _setjmp, . - _setjmp

.global longjmp
.type longjmp, %function
longjmp:
    ldp x19, x20, [x0, #0]
    ldp x21, x22, [x0, #16]
    ldp x23, x24, [x0, #32]
    ldp x29, x30, [x0, #48]
    ldr x2, [x0, #64]
    mov sp, x2
    mov x0, x1
    cmp x0, #0
    cinc x0, x0, eq
    ret
.size longjmp, . - longjmp

.global _longjmp
.type _longjmp, %function
_longjmp:
    b longjmp
.size _longjmp, . - _longjmp
ASMEOF
"$CC" --target=$TRIPLE -ffreestanding -nostdlib -c "$LIBC_BUILD/simpleos_crt0_aarch64.S" -o "$LIBC_BUILD/simpleos_crt0.o"
"$CC" --target=$TRIPLE -ffreestanding -nostdlib -c "$LIBC_BUILD/simpleos_syscall_aarch64.S" -o "$LIBC_BUILD/simpleos_syscall.o"
"$CC" --target=$TRIPLE -ffreestanding -nostdlib -c "$LIBC_BUILD/simpleos_setjmp_aarch64.S" -o "$LIBC_BUILD/simpleos_setjmp.o"
rm -f "$SYSROOT/lib/libsimpleos_c.a"
"$AR" rcs "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD"/*.o
cp "$LIBC_BUILD/simpleos_crt0.o" "$SYSROOT/lib/crt0.o"
echo "[sysroot-aarch64] Installed libsimpleos_c.a + crt0.o"

# Pre-existing libc duplicate: simpleos_pthread.o and simpleos_pthread_cond.o
# both define the pthread_cond family; localize the copies in pthread.o so the
# dedicated cond TU (superset: adds timedwait) is the unique global provider.
llvm-objcopy --localize-symbol=pthread_cond_init --localize-symbol=pthread_cond_destroy \
    --localize-symbol=pthread_cond_signal --localize-symbol=pthread_cond_broadcast \
    --localize-symbol=pthread_cond_wait --localize-symbol=pthread_condattr_init \
    --localize-symbol=pthread_condattr_destroy "$LIBC_BUILD/simpleos_pthread.o"
"$AR" r "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD/simpleos_pthread.o"
echo "[sysroot-aarch64] Localized duplicate pthread_cond_* in simpleos_pthread.o"

# -- entry + Simple runtime ABI (aarch64 branch) ------------------------------
"$CC" $CFLAGS -ffunction-sections -fdata-sections \
    -c "$LIBC_DIR/simpleos_entry.c" -o "$SYSROOT/lib/simple_entry.o"
mkdir -p "$LIBC_BUILD/entry"
"$CC" $CFLAGS -ffunction-sections -fdata-sections \
    -c "$LIBC_DIR/simpleos_simple_runtime.c" -o "$LIBC_BUILD/entry/simpleos_simple_runtime.o"
rm -f "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"
"$AR" rcs "$SYSROOT/lib/libsimple_runtime_compat.a" "$LIBC_BUILD/entry/simpleos_simple_runtime.o"
cp "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"

echo "[sysroot-aarch64] Cross-compiling Simple runtime sources for $TRIPLE..."
RT_BUILD="$LIBC_BUILD/simple_runtime_native"
mkdir -p "$RT_BUILD"
RT_CFLAGS="--target=$TRIPLE -ffreestanding -nostdlib -nostdlibinc \
    -fno-builtin -fno-stack-protector -fno-exceptions \
    -fno-unwind-tables -fno-asynchronous-unwind-tables \
    -ffunction-sections -fdata-sections -O2 -D__simpleos__=1 \
    -DSIMPLE_RUNTIME_FREESTANDING_V2 -Wno-implicit-function-declaration \
    -isystem $LIBC_DIR/include"
RT_OBJS=""
RT_FAILED=""
for rt_src in runtime_simd_utf8 runtime_contracts \
              runtime_memory runtime_time runtime_timestamp \
              runtime_pool runtime_memtrack \
              runtime_simpleos_syscall_adapters \
              startup/baremetal/runtime_log
do
    rt_obj="$RT_BUILD/$(basename "$rt_src").o"
    if "$CC" $RT_CFLAGS -c "$REPO_ROOT/src/runtime/$rt_src.c" -o "$rt_obj"; then
        RT_OBJS="$RT_OBJS $rt_obj"
    else
        echo "[sysroot-aarch64] WARNING: skipping failed runtime source: $rt_src.c"
        RT_FAILED="$RT_FAILED $rt_src"
    fi
done
rm -f "$SYSROOT/lib/libsimple_runtime_native.a"
"$AR" rcs "$SYSROOT/lib/libsimple_runtime_native.a" $RT_OBJS
cp "$SYSROOT/lib/libsimple_runtime_native.a" "$SYSROOT/lib/libsimple_runtime.a"
echo "[sysroot-aarch64] Built libsimple_runtime_native.a ($(echo $RT_OBJS | wc -w) members) skipped:${RT_FAILED:- none}"
echo "[sysroot-aarch64] NOTE: runtime_native.c excluded (same Simple-HEAD drift as x86_64; not consumed by clang lanes)"

# -- libc++ (same source list + flags as x86_64, aarch64 target) --------------
echo "[sysroot-aarch64] Building libc++.a for $TRIPLE..."
mkdir -p "$LIBCXX_BUILD"
LIBCXX_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -std=c++23 -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -fsized-deallocation -fsigned-char -D__simpleos__=1 -DLIBC_NAMESPACE=__llvm_libc -D_LIBCPP_BUILDING_LIBRARY -D_LIBCPP_BUILDING_HAS_NO_ABI_LIBRARY -D_LIBCPP_REMOVE_TRANSITIVE_INCLUDES -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS= -D_LIBCPP_PSTL_BACKEND_SERIAL=1 -D_LIBCPP_HAS_CLOCK_GETTIME=1 -I$LLVM_SRC/libcxx/src -I$LLVM_SRC/libc -isystem $SYSROOT/include/c++/v1 -isystem $SYSROOT/include"
for src in \
    new.cpp algorithm.cpp any.cpp bind.cpp call_once.cpp charconv.cpp chrono.cpp \
    error_category.cpp exception.cpp expected.cpp \
    filesystem/filesystem_clock.cpp filesystem/filesystem_error.cpp \
    filesystem/path.cpp functional.cpp hash.cpp memory.cpp \
    memory_resource.cpp new_handler.cpp new_helpers.cpp optional.cpp \
    print.cpp random.cpp random_shuffle.cpp ryu/d2fixed.cpp ryu/d2s.cpp \
    ryu/f2s.cpp stdexcept.cpp string.cpp system_error.cpp typeinfo.cpp \
    valarray.cpp variant.cpp vector.cpp verbose_abort.cpp \
    atomic.cpp barrier.cpp condition_variable_destructor.cpp \
    condition_variable.cpp future.cpp mutex_destructor.cpp mutex.cpp \
    shared_mutex.cpp thread.cpp
do
    obj="$LIBCXX_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
    mkdir -p "$(dirname "$obj")"
    PERFILE_FLAGS="$LIBCXX_FLAGS"
    # 2026-09-26 lane-C1 R6: with libc++abi linked alongside (exceptions
    # build), libc++ must NOT take the fallback EH path in exception.cpp /
    # new_handler.cpp — the fallback terminate/unexpected/new_handler family
    # collides strong/strong with libc++abi's cxa_handlers /
    # cxa_default_handlers at link time. LIBCXX_BUILDING_LIBCXXABI routes
    # them to the libcxxabi .ipp split (upstream pairing).
    case "$src" in
        exception.cpp|new_handler.cpp) PERFILE_FLAGS="$LIBCXX_FLAGS -DLIBCXX_BUILDING_LIBCXXABI -I$LLVM_SRC/libcxxabi/include" ;;
    esac
    "$CXX" $PERFILE_FLAGS -c "$LLVM_SRC/libcxx/src/$src" -o "$obj"
done
rm -f "$SYSROOT/lib/libc++.a"
"$AR" rcs "$SYSROOT/lib/libc++.a" "$LIBCXX_BUILD"/*.o
echo "[sysroot-aarch64] Installed libc++.a"

# -- libc++abi (WITH exceptions, 2026-09-26 lane-C1 R6) ------------------------
# The guest C++ witness (WITNESS.CPP) needs the exception runtime. The
# no-exceptions build omitted cxa_exception.cpp/cxa_personality.cpp entirely
# (no __cxa_throw / __gxx_personality_v0 anywhere in the archive). Exceptions
# are now compiled in; cxa_personality.cpp needs -frtti (typeid on
# std::bad_exception), same per-file exception as private_typeinfo.cpp.
echo "[sysroot-aarch64] Building libc++abi.a (exceptions) for $TRIPLE..."
mkdir -p "$LIBCXXABI_BUILD"
LIBCXXABI_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -std=c++23 -ffreestanding -nostdlib -nostdinc++ -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -fstrict-aliasing -fsigned-char -D__simpleos__=1 -D_LIBCPP_BUILDING_LIBRARY -DHAVE___CXA_THREAD_ATEXIT_IMPL=0 -I$LLVM_SRC/libcxxabi/include -I$LLVM_SRC/libcxxabi/src -I$LLVM_SRC/libcxx/src -isystem $SYSROOT/include/c++/v1 -isystem $SYSROOT/include"
for src in \
    cxa_aux_runtime.cpp cxa_default_handlers.cpp cxa_demangle.cpp \
    cxa_exception.cpp cxa_exception_storage.cpp cxa_guard.cpp cxa_handlers.cpp \
    cxa_personality.cpp \
    cxa_vector.cpp cxa_virtual.cpp cxa_noexception.cpp \
    stdlib_exception.cpp stdlib_stdexcept.cpp stdlib_typeinfo.cpp \
    abort_message.cpp fallback_malloc.cpp private_typeinfo.cpp
do
    obj="$LIBCXXABI_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
    PERFILE_FLAGS="$LIBCXXABI_FLAGS"
    case "$src" in
        private_typeinfo.cpp|cxa_personality.cpp) PERFILE_FLAGS="$(printf '%s' "$LIBCXXABI_FLAGS" | sed 's/-fno-rtti/-frtti/')" ;;
    esac
    "$CXX" $PERFILE_FLAGS -c "$LLVM_SRC/libcxxabi/src/$src" -o "$obj"
done
rm -f "$SYSROOT/lib/libc++abi.a"
"$AR" rcs "$SYSROOT/lib/libc++abi.a" "$LIBCXXABI_BUILD"/*.o
echo "[sysroot-aarch64] Installed libc++abi.a"

# -- libunwind ----------------------------------------------------------------
echo "[sysroot-aarch64] Building libunwind.a for $TRIPLE..."
mkdir -p "$LIBUNWIND_BUILD"
LIBUNWIND_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -D__simpleos__=1 -D_LIBUNWIND_IS_BAREMETAL -D_LIBUNWIND_HAS_NO_THREADS -I$LLVM_SRC/libunwind/include -isystem $SYSROOT/include"
for src in libunwind.cpp UnwindLevel1.c UnwindLevel1-gcc-ext.c Unwind-sjlj.c; do
    obj="$LIBUNWIND_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
    case "$src" in
        *.cpp) "$CXX" -std=c++17 $LIBUNWIND_FLAGS -c "$LLVM_SRC/libunwind/src/$src" -o "$obj" ;;
        *.c)   "$CC" $LIBUNWIND_FLAGS -c "$LLVM_SRC/libunwind/src/$src" -o "$obj" ;;
    esac
done
rm -f "$SYSROOT/lib/libunwind.a"
"$AR" rcs "$SYSROOT/lib/libunwind.a" "$LIBUNWIND_BUILD"/*.o
echo "[sysroot-aarch64] Installed libunwind.a"

# -- compat shims (rebuilt for aarch64 from the x86_64 sources) ----------------
echo "[sysroot-aarch64] Building compat shims + main shim for aarch64..."
SHIMSRC="$WORK/libc-build-x86_64/posix_shims.c"
"$CC" --target=$TRIPLE -ffreestanding -nostdlib -fno-builtin -fno-stack-protector \
    -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
    -O2 -isystem "$SYSROOT/include" -c "$SHIMSRC" -o "$LIBC_BUILD/libcxx_compat.o"
"$AR" r "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD/libcxx_compat.o"

cat > "$LIBC_BUILD/main_shim.S" << 'EOF'
/* lane-C1 aarch64: freestanding C++ driver code emits main(int, char**)
   (_Z4mainiPPc — clang/lld driver.cpp); crt0.o calls plain C main with
   x0=argc, x1=argv. The tail branch forwards argc/argv unchanged. The
   previous shim targeted _Z4mainv, which no aarch64 driver object defines;
   lld resolves a branch to an undefined weak symbol as a fallthrough, so
   `main` fell straight into the next archive member (pread) and the real
   driver main never ran (bug doc 2026-09-26, defect 2). C programs with a
   strong main override this weak shim as before. */
    .weak _Z4mainiPPc
    .weak main
    .type main, %function
main:
    b _Z4mainiPPc
    .size main, .-main
EOF
"$CC" --target=$TRIPLE -ffreestanding -nostdlib -c "$LIBC_BUILD/main_shim.S" -o "$LIBC_BUILD/main_shim.o"
"$AR" r "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD/main_shim.o"

# -- linker script + placeholders (same as x86_64) -----------------------------
cat > "$SYSROOT/share/simpleos/simpleos.ld" << 'LDEOF'
/* SimpleOS aarch64 userspace linker script — mirrors the x86_64 layout
 * (text at 0x10000000, static linking only). */
ENTRY(_start)

SECTIONS {
    . = 0x10000000;

    .text : {
        *(.text.entry)
        *(.text .text.*)
    }

    . = ALIGN(4096);
    .rodata : {
        *(.rodata .rodata.*)
    }

    . = ALIGN(4096);
    .data : {
        *(.data .data.*)
        *(.sdata .sdata.*)
    }

    /* The AArch64 psABI routes references to weak data symbols through GOT
     * slots even in -fno-pic -static links, and -Wl,--export-dynamic blocks
     * lld's GOT->direct relaxation. Discarding .got left lld's synthetic GOT
     * allocated as an unmapped orphan (page 0xb) with dangling absolute
     * references from __libc_init_array (bug doc 2026-09-26, defect 3:
     * FAR=0xb1c8 translation fault at EL0). The slots are link-time
     * constants here, so map them like ordinary .data. */
    . = ALIGN(16);
    .got : {
        *(.got .got.*)
    }

    . = ALIGN(16);
    .init_array : {
        __init_array_start = .;
        KEEP(*(.init_array .init_array.*))
        __init_array_end = .;
    }

    . = ALIGN(16);
    .fini_array : {
        __fini_array_start = .;
        KEEP(*(.fini_array .fini_array.*))
        __fini_array_end = .;
    }

    . = ALIGN(16);
    .tdata : {
        _tls_start = .;
        *(.tdata .tdata.*)
    }

    . = ALIGN(16);
    .tbss : {
        *(.tbss .tbss.*)
        _tls_end = .;
    }

    . = ALIGN(4096);
    .bss : {
        __bss_start = .;
        *(.bss .bss.*)
        *(.sbss .sbss.*)
        *(COMMON)
        __bss_end = .;
    }

    _end = .;

    /DISCARD/ : {
        *(.comment)
        *(.note .note.*)
        *(.eh_frame)
        *(.eh_frame_hdr)
        *(.plt)
        *(.rela.plt)
    }
}
LDEOF
printf '%s\n' "$TRIPLE" > "$SYSROOT/share/simpleos/target-triple.txt"
for l in libm libpthreads librt libdl libzircon; do
    if [ ! -f "$SYSROOT/lib/$l.a" ]; then
        printf 'int __simpleos_%s_placeholder;\n' "${l#lib}" > "$LIBC_BUILD/${l#lib}_ph.c"
        "$CC" --target=$TRIPLE -ffreestanding -nostdlib -c "$LIBC_BUILD/${l#lib}_ph.c" -o "$LIBC_BUILD/${l#lib}_ph.o"
        "$AR" rcs "$SYSROOT/lib/$l.a" "$LIBC_BUILD/${l#lib}_ph.o"
        echo "[sysroot-aarch64] Installed placeholder $l.a"
    fi
done

echo "[sysroot-aarch64] Sysroot ready: $SYSROOT"
ls -la "$SYSROOT/lib/"
